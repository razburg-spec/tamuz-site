// Cloudflare Worker that serves the static site in ./site (no build step on Cloudflare).
{
  "name": "razburg-site",
  "compatibility_date": "2026-10-01",
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    // /studio is served from studio.html, so every Wix URL keeps its exact path
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
